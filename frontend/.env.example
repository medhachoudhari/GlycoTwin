# Copy to .env.local (git-ignored). Both values are optional.
# Base URL the browser uses for the API. Default "/api" goes through the Vite proxy (no CORS needed).
# An absolute URL such as http://127.0.0.1:8000 only works if the backend allows that origin (it does not by default).
VITE_API_BASE_URL=/api
# Where the Vite dev/preview server forwards /api requests.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
