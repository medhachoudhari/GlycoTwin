# Copy to .env (git-ignored) and edit. Contains no secrets.
# Absolute path to the local CGMacros dataset root (outside or inside the repo).
GLYCOTWIN_DATA_ROOT=/path/to/CGMacros

# --- Backend (FastAPI + SQLite) ---
# Database URL; SQLite file by default (git-ignored folder). Never point this at a shared or production database.
GLYCOTWIN_DATABASE_URL=sqlite:///data/interim/glycotwin_backend.sqlite3
# Folder holding AGGREGATE prior artifacts written by scripts/export_prior.py (git-ignored).
GLYCOTWIN_PRIOR_DIR=data/interim/priors
# Activity (METs) at which Model C's sensitivity is REPORTED in state views (reporting convention, not a model parameter).
GLYCOTWIN_REFERENCE_ACTIVITY=1.0

# --- Accounts and sessions (backend) ---
# How long a normal sign-in lasts, in days.
GLYCOTWIN_SESSION_DAYS=7
# How long a temporary guest (demo) account lasts, in hours.
GLYCOTWIN_GUEST_HOURS=24
# Set to true ONLY when the site is served over HTTPS (the session cookie is then sent only over HTTPS).
GLYCOTWIN_COOKIE_SECURE=false
# Set to false to stop new accounts / guest accounts being created (existing accounts can still sign in).
GLYCOTWIN_ALLOW_REGISTRATION=true
GLYCOTWIN_ALLOW_GUEST=true
